{% set _profile = render_mode == "stable" or render_mode == "thoughts" or render_mode == "transform" or (render_mode == "full" and not default(stable_split, false)) %}
{% set isFullDescription = _profile or render_mode == "dialogue_target" %}
{% set shouldRender = isFullDescription or render_mode == "short_inline" %}
{% if not decnpc(actorUUID).isVirtual and shouldRender and ttlb_is_excluded(actorUUID) != "true" %}
    {{render_subcomponent("body_language", render_mode)}}
{% endif %}
